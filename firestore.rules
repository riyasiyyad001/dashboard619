rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-all default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPayload(data) {
      return data.keys().hasAll(['payload']) &&
             data.payload is string &&
             data.payload.size() <= 2097152; // Max 2MB payload
    }

    // Shared Master Executive State across all devices (Worldwide Multi-device sync)
    match /app_data/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(request.resource.data);
      allow delete: if isSignedIn() && isValidId(docId);
    }

    // Per-user dashboard state
    match /users/{userId}/dashboard/state {
      allow read: if isSignedIn() && isValidId(userId);
      allow create, update: if isSignedIn() && isValidId(userId) && isValidPayload(request.resource.data);
      allow delete: if isSignedIn() && isValidId(userId);
    }
  }
}
